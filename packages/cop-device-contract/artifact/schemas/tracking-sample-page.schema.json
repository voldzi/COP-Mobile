{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cop.local/device/v1/tracking-sample-page.schema.json",
  "title": "COP Device Tracking Sample Page",
  "type": "object",
  "additionalProperties": false,
  "required": ["sessionId", "samples"],
  "properties": {
    "sessionId": { "$ref": "common.schema.json#/$defs/uuid" },
    "samples": { "type": "array", "items": { "$ref": "location-sample.schema.json" }, "maxItems": 1000 },
    "nextCursor": { "type": ["string", "null"], "maxLength": 512 }
  }
}
