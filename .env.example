COP_CSM_MESSAGING_BASE_URL=https://msg.zeleznalady.cz
COP_DEVICE_CONTRACT_VERSION=1.0.0
COP_NATIVE_BRIDGE_ENABLED=true
COP_CRITICAL_ALERTS_ENABLED=false
COP_NEARBY_RELAY_ENABLED=false
COP_RELAY_SENSITIVE_PAYLOADS_ENABLED=false
